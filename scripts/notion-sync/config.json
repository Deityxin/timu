  "auto_type_breakthrough_map": {
    "DP": "看到最优子结构和状态转移时优先考虑 DP",
    "DP-背包": "容量约束下最大值/方案数优先考虑 01/完全/多重背包",
    "DP-区间DP": "区间合并与左右端点转移优先考虑区间 DP",
    "DP-数位DP": "按数位逐位限制统计时优先考虑数位 DP",
    "DP-状压DP": "状态是子集或位掩码时优先考虑状压 DP",
    "图论": "图上的最短路/连通性/有向无环结构优先建图处理",
    "图论-最短路": "带权图路径问题优先判断是否用 Dijkstra/SPFA/Floyd",
    "图论-拓扑排序": "有向无环依赖关系优先考虑拓扑排序",
    "图论-最小生成树": "连通图最小连边代价优先考虑 Kruskal/Prim",
    "图论-连通分量": "强连通分量/桥/割点问题优先考虑 Tarjan",
    "图论-二分图匹配": "二分图最大匹配优先考虑匈牙利或 KM",
    "树": "层次关系明显时优先考虑树形遍历或树上倍增",
    "树-LCA": "频繁祖先查询优先考虑倍增 LCA",
    "树-树形DP": "子树贡献合并时优先考虑树形 DP",
    "数据结构": "需要高频更新与查询时优先选择合适数据结构",
    "数据结构-并查集": "集合合并与连通性判断优先考虑并查集",
    "数据结构-线段树": "区间更新与区间查询并存时优先考虑线段树",
    "数据结构-树状数组": "前缀和动态维护优先考虑树状数组",
    "数据结构-单调结构": "区间最值滑动维护优先考虑单调栈/队列",
    "数据结构-堆": "实时维护前k或最值集合优先考虑堆",
    "字符串": "大量模式匹配时优先考虑字符串算法",
    "字符串-KMP": "单模式匹配优先考虑 KMP",
    "字符串-Trie": "字典前缀检索优先考虑 Trie",
    "字符串-哈希": "字符串等价与子串比较问题优先考虑滚动哈希",
    "字符串-AC自动机": "多模式匹配优先考虑 AC 自动机",
    "数论": "出现质数与整除关系时优先考虑数论工具",
    "数论-筛法与质数": "批量判质数优先筛法",
    "数论-整除与同余": "gcd/exgcd/同余方程优先数论分解",
    "数论-快速幂": "幂取模与快速指数运算优先快速幂",
    "数论-矩阵快速幂": "线性递推高次幂优先考虑矩阵快速幂",
    "二分": "答案单调时优先考虑二分",
    "贪心": "局部最优可推出全局时优先贪心",
    "双指针/滑动窗口": "区间连续约束优先双指针或滑动窗口",
    "前缀和与差分": "批量区间求和或区间增减优先前缀和/差分",
    "排序与模拟": "规则明确且可直接按流程实现时优先模拟",
    "基础算法": "先找不变量，再选择最小必要算法"
  },
  "auto_keyword_rules": [
    {
      "pattern": "未完成|todo",
      "status": "待做",
      "tags": "未完成|待复盘"
    },
    {
      "pattern": "修改|xiugai",
      "tags": "复盘修改"
    },
    {
      "pattern": "背包|knapsack|01\\s*bag|complete\\s*bag|group\\s*bag|multiple\\s*bag",
      "type": "DP-背包"
    },
    {
      "pattern": "digit\\s*dp|数位\\s*dp",
      "type": "DP-数位DP"
    },
    {
      "pattern": "interval\\s*dp|区间\\s*dp",
      "type": "DP-区间DP"
    },
    {
      "pattern": "bitmask|subset\\s*dp|状压\\s*dp",
      "type": "DP-状压DP"
    },
    {
      "pattern": "dijkstra|最短路",
      "type": "图论-最短路",
      "breakthrough": "权重图最短路优先考虑 Dijkstra"
    },
    {
      "pattern": "spfa|floyd|bellman",
      "type": "图论-最短路"
    },
    {
      "pattern": "topological|topo|in_degree|indegree",
      "type": "图论-拓扑排序"
    },
    {
      "pattern": "kruskal|prim|minimum\\s*spanning|mst",
      "type": "图论-最小生成树"
    },
    {
      "pattern": "tarjan|\\bscc\\b|strongly\\s*connected|bridge|cut\\s*vertex|割点|桥",
      "type": "图论-连通分量"
    },
    {
      "pattern": "bipartite|二分图|hungarian|km\\b|maximum\\s*matching",
      "type": "图论-二分图匹配"
    },
    {
      "pattern": "templates/dsu|\\bdsu\\b|union\\s*find",
      "type": "数据结构-并查集"
    },
    {
      "pattern": "templates/segment_tree|templates/lazy_segment_tree|segment\\s*tree",
      "type": "数据结构-线段树"
    },
    {
      "pattern": "templates/fenwick|fenwick|\\bbit\\b",
      "type": "数据结构-树状数组"
    },
    {
      "pattern": "templates/monotonic_queue|monotonic\\s*stack|monotonic\\s*queue",
      "type": "数据结构-单调结构"
    },
    {
      "pattern": "单调栈|单调队列",
      "type": "数据结构-单调结构"
    },
    {
      "pattern": "priority_queue|\\bheap\\b",
      "type": "数据结构-堆"
    },
    {
      "pattern": "堆|优先队列",
      "type": "数据结构-堆"
    },
    {
      "pattern": "templates/kmp|\\bkmp\\b",
      "type": "字符串-KMP"
    },
    {
      "pattern": "templates/trie|\\btrie\\b",
      "type": "字符串-Trie"
    },
    {
      "pattern": "字典树",
      "type": "字符串-Trie"
    },
    {
      "pattern": "rolling\\s*hash|string\\s*hash|rk\\s*hash|rabin\\s*karp",
      "type": "字符串-哈希"
    },
    {
      "pattern": "ac\\s*automaton|aho\\s*corasick|ac自动机",
      "type": "字符串-AC自动机"
    },
    {
      "pattern": "templates/sieve|\\bsieve\\b|\\bprime\\b",
      "type": "数论-筛法与质数"
    },
    {
      "pattern": "\\bgcd\\b|\\blcm\\b|\\bexgcd\\b|\\bphi\\b",
      "type": "数论-整除与同余"
    },
    {
      "pattern": "templates/fast_pow|fast\\s*pow|pow\\s*\\(",
      "type": "数论-快速幂"
    },
    {
      "pattern": "matrix\\s*(quick\\s*)?pow|矩阵快速幂",
      "type": "数论-矩阵快速幂"
    },
    {
      "pattern": "templates/lca|\\blca\\b|binary\\s*lifting",
      "type": "树-LCA"
    },
    {
      "pattern": "最近公共祖先",
      "type": "树-LCA"
    },
    {
      "pattern": "tree\\s*dp|subtree",
      "type": "树-树形DP"
    },
    {
      "pattern": "two[-_ ]?pointer|sliding\\s*window",
      "type": "双指针/滑动窗口"
    },
    {
      "pattern": "双指针|滑动窗口",
      "type": "双指针/滑动窗口"
    },
    {
      "pattern": "prefix\\s*sum|difference\\s*array",
      "type": "前缀和与差分"
    },
    {
      "pattern": "前缀和|差分",
      "type": "前缀和与差分"
    },
    {
      "pattern": "sort\\s*\\(|simulation|simulate",
      "type": "排序与模拟"
    },
    {
      "pattern": "排序|模拟|枚举",
      "type": "排序与模拟"
    }
  ],
